# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm / JetBrains
.idea/

# Sublime Text / Vim
*.sublime-project
*.sublime-workspace
*.swp
*.swo

