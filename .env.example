# Configuración de PostgreSQL
POSTGRES_USER=usuario_app
POSTGRES_PASSWORD=password_app
POSTGRES_DB=bonita_emergencias_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL de la Base de Datos para SQLAlchemy
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Configuración de Flask
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=clave_secreta_super_segura_para_desarrollo
# Bonita: usar el puerto real del Runtime/Studio.
# Desde Docker, host.docker.internal accede a Bonita ejecutado en Windows.
BONITA_URL=http://host.docker.internal:8080/bonita
BONITA_USERNAME=
BONITA_PASSWORD=
BONITA_TIMEOUT=15
