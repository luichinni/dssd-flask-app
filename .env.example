# Configuración de PostgreSQL
POSTGRES_USER=usuario_app
POSTGRES_PASSWORD=password_app
POSTGRES_DB=bonita_emergencias_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL de la Base de Datos para SQLAlchemy
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Configuración de Flask
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=clave_secreta_super_segura_para_desarrollo
# Bonita: usar el puerto real del Runtime/Studio.
# Desde Docker, host.docker.internal accede a Bonita ejecutado en Windows.
BONITA_URL=http://host.docker.internal:8080/bonita
# Credenciales de prueba para el runtime local de Bonita.
BONITA_USERNAME=municipio.operador
BONITA_PASSWORD=123
BONITA_CCR_USERNAME=ccr.coordinador
BONITA_CCR_PASSWORD=123
BONITA_ONG_USERNAME=ong.representante
BONITA_ONG_PASSWORD=123
BONITA_SISTEMA_NACIONAL_USERNAME=sistema.nacional
BONITA_SISTEMA_NACIONAL_PASSWORD=123
BONITA_TIMEOUT=15
BONITA_CALLBACK_API_KEY=
# Dejar vacío para usar el servicio del Compose. Para Kubernetes, indicar su URL.
PRIORIDADES_URL=
